{
    "schema_version": 1,

    "target": {
        "project_slug": "aurora",
    },

    "add_initiatives": [
        {
            "title": "Planning Knowledge Pipeline",
            "description": (
                "Design, implement, validate, and document the canonical "
                "workflow that transforms architectural discussions into "
                "validated Decision Engine planning records through "
                "discoverable, repository-owned contracts. This Initiative "
                "establishes the standard entry path for future Aurora and "
                "HopeHub Initiatives and serves as the first historical "
                "reference implementation of the Hansel strategy."
            ),
            "status": "ACTIVE",
            "phases": [
                {
                    "title": "Establish the Planning Handoff",
                    "description": (
                        "Define and publish the durable artifact produced by "
                        "an architectural discussion. The handoff preserves "
                        "architectural intent, decisions, boundaries, scope, "
                        "known authorities, and the first breadcrumb in the "
                        "Hansel planning trail."
                    ),
                    "status": "COMPLETED",
                    "steps": [
                        {
                            "title": "Define the handoff responsibility",
                            "description": (
                                "Establish that a Planning Handoff preserves "
                                "architectural intent while directing the next "
                                "worker to the authoritative planning-import "
                                "contract rather than duplicating its "
                                "mechanical rules."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 45,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The approved handoff definition clearly "
                                "separates architectural discussion context "
                                "from planning-import mechanics."
                            ),
                        },
                        {
                            "title": "Define the handoff structure",
                            "description": (
                                "Define the required sections for target "
                                "Project, proposed Initiative, architectural "
                                "objective, problem statement, decisions, "
                                "scope, deliverables, success conditions, "
                                "authoritative paths, and Hansel navigation."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 60,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The handoff format contains enough durable "
                                "architectural context for a worker without "
                                "access to the originating conversation."
                            ),
                        },
                        {
                            "title": "Publish the reference Planning Handoff",
                            "description": (
                                "Create the Planning Knowledge Pipeline "
                                "handoff as the first repository-owned "
                                "breadcrumb for this Initiative."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 45,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The Planning Knowledge Pipeline handoff "
                                "exists at its approved repository path and "
                                "directs the reader to the Planning Update "
                                "Contract."
                            ),
                        },
                    ],
                },
                {
                    "title": "Publish the Planning Update Contract",
                    "description": (
                        "Document the authoritative planning-update workflow, "
                        "input format, naming convention, supported "
                        "operations, schema rules, append-only behavior, "
                        "validation commands, transaction behavior, and "
                        "Hansel navigation."
                    ),
                    "status": "COMPLETED",
                    "steps": [
                        {
                            "title": "Inspect the management command",
                            "description": (
                                "Inspect import_planning_dictionary.py to "
                                "confirm file parsing, command arguments, "
                                "natural-key user resolution, dry-run mode, "
                                "apply mode, and updater delegation."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 30,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The documented command contract matches the "
                                "current management-command implementation."
                            ),
                        },
                        {
                            "title": "Inspect the planning updater",
                            "description": (
                                "Inspect updater.py to confirm target "
                                "validation, append-only semantics, duplicate "
                                "detection, position assignment, record "
                                "creation, transaction boundaries, and result "
                                "counts."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 45,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The documented persistence workflow matches "
                                "the current planning updater."
                            ),
                        },
                        {
                            "title": "Inspect the planning schema",
                            "description": (
                                "Inspect schema.py to confirm schema version, "
                                "allowed fields, required structures, "
                                "defaults, enum validation, title uniqueness, "
                                "unknown-field rejection, and update-specific "
                                "normalization."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 60,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The accepted planning-update dictionary "
                                "structure is derived from the executable "
                                "schema rather than an outdated example."
                            ),
                        },
                        {
                            "title": "Publish the authoritative contract",
                            "description": (
                                "Create PLANNING_UPDATE_CONTRACT.md with "
                                "definitive implementation paths, supported "
                                "structures, naming rules, safety requirements, "
                                "commands, and Hansel navigation."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 90,
                            "estimate_confidence": "HIGH",
                            "risk_level": "MEDIUM",
                            "risk_description": (
                                "An inaccurate contract could teach future "
                                "workers to generate invalid imports."
                            ),
                            "validation_description": (
                                "The published contract agrees with the "
                                "management command, schema, and updater and "
                                "contains no unsupported fields."
                            ),
                        },
                    ],
                },
                {
                    "title": "Publish the Canonical Template",
                    "description": (
                        "Create a copyable schema-version-one planning-update "
                        "template that demonstrates the exact dictionary "
                        "shape accepted by the current importer."
                    ),
                    "status": "COMPLETED",
                    "steps": [
                        {
                            "title": "Define the template location",
                            "description": (
                                "Place the canonical template beside the "
                                "planning IO implementation so its ownership "
                                "and relationship to the schema are "
                                "discoverable."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 20,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The canonical template path is recorded in "
                                "the Planning Update Contract and Planning "
                                "Handoff."
                            ),
                        },
                        {
                            "title": "Create the schema-version-one template",
                            "description": (
                                "Create planning_update_v1.plan containing "
                                "one Python-literal dictionary with target, "
                                "add_initiatives, add_phases, add_steps, and "
                                "all currently supported Step fields."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 30,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The template contains only schema-supported "
                                "fields and can be copied without requiring "
                                "knowledge of importer implementation."
                            ),
                        },
                        {
                            "title": "Document the import naming convention",
                            "description": (
                                "Adopt the project-local filename convention "
                                "<project_slug>_<sequence>_<scope>.plan for "
                                "Decision Engine planning updates."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 20,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The naming convention is documented in the "
                                "contract and used by this Initiative's "
                                "reference import."
                            ),
                        },
                    ],
                },
                {
                    "title": "Generate the Reference Import",
                    "description": (
                        "Use the Planning Handoff, Planning Update Contract, "
                        "canonical template, current schema, and current "
                        "Decision Engine state to generate the planning "
                        "dictionary for this Initiative."
                    ),
                    "status": "ACTIVE",
                    "steps": [
                        {
                            "title": "Create the project import directory",
                            "description": (
                                "Create the repository location that stores "
                                "durable, project-specific Decision Engine "
                                "planning imports."
                            ),
                            "status": "COMPLETED",
                            "estimated_minutes": 10,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The planning_imports directory exists under "
                                "docs/aurora/management and is suitable for "
                                "version-controlled historical imports."
                            ),
                        },
                        {
                            "title": "Create the Planning Knowledge Pipeline import",
                            "description": (
                                "Create the schema-version-one append-only "
                                "planning dictionary that records this "
                                "Initiative, its historical completed work, "
                                "its current active work, and its remaining "
                                "planned validation."
                            ),
                            "status": "ACTIVE",
                            "estimated_minutes": 120,
                            "estimate_confidence": "HIGH",
                            "risk_level": "MEDIUM",
                            "risk_description": (
                                "Incorrect titles or unsupported fields could "
                                "cause validation failure or create an "
                                "inaccurate historical hierarchy."
                            ),
                            "validation_description": (
                                "The import dictionary follows the canonical "
                                "template, contains no unknown fields, and "
                                "accurately represents completed, active, and "
                                "planned work."
                            ),
                        },
                        {
                            "title": "Review the historical status assignments",
                            "description": (
                                "Confirm that completed discovery and contract "
                                "work is recorded as completed, current import "
                                "generation is active, and future validation "
                                "work remains planned."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 30,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The imported hierarchy accurately preserves "
                                "the sequence in which the Planning Knowledge "
                                "Pipeline was discovered and implemented."
                            ),
                        },
                    ],
                },
                {
                    "title": "Validate and Apply the Import",
                    "description": (
                        "Validate the reference dictionary against the "
                        "current schema and database state, then apply the "
                        "complete hierarchy transactionally."
                    ),
                    "status": "PLANNED",
                    "steps": [
                        {
                            "title": "Run planning-import dry validation",
                            "description": (
                                "Execute import_planning_dictionary with "
                                "--dry-run using the reference import and the "
                                "delta user natural key."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 20,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The command reports VALIDATED for project "
                                "aurora with the expected Initiative, Phase, "
                                "and Step counts and performs no writes."
                            ),
                        },
                        {
                            "title": "Resolve validation failures",
                            "description": (
                                "Correct schema, title-conflict, target, or "
                                "database-state errors discovered by the dry "
                                "run without bypassing validation."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 60,
                            "estimate_confidence": "MEDIUM",
                            "risk_level": "MEDIUM",
                            "risk_description": (
                                "Unexpected existing titles or contract drift "
                                "may require adjusting the import while "
                                "preserving architectural intent."
                            ),
                            "validation_description": (
                                "Every reported validation failure is "
                                "resolved through a documented correction and "
                                "the final dry run succeeds."
                            ),
                        },
                        {
                            "title": "Apply the planning import",
                            "description": (
                                "Run import_planning_dictionary with --apply "
                                "only after successful dry-run validation."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 15,
                            "estimate_confidence": "HIGH",
                            "risk_level": "MEDIUM",
                            "risk_description": (
                                "The operation writes the complete planning "
                                "hierarchy to the Decision Engine."
                            ),
                            "validation_description": (
                                "The command reports APPLIED with the expected "
                                "counts and no partial hierarchy exists if the "
                                "transaction fails."
                            ),
                        },
                        {
                            "title": "Verify the imported hierarchy",
                            "description": (
                                "Inspect the Aurora Project in the Decision "
                                "Engine and confirm the Initiative, Phase, "
                                "Step, ordering, status, estimates, risks, and "
                                "validation requirements."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 30,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The visible Decision Engine hierarchy matches "
                                "the reference planning dictionary."
                            ),
                        },
                    ],
                },
                {
                    "title": "Verify the Hansel Trail",
                    "description": (
                        "Prove that a worker without access to the originating "
                        "conversation can follow the repository-owned "
                        "breadcrumbs from architectural intent to a valid "
                        "Decision Engine import."
                    ),
                    "status": "PLANNED",
                    "steps": [
                        {
                            "title": "Perform a clean-context walkthrough",
                            "description": (
                                "Begin with only the Planning Handoff and "
                                "follow each referenced artifact without using "
                                "conversation history or remembered importer "
                                "rules."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 90,
                            "estimate_confidence": "MEDIUM",
                            "risk_level": "MEDIUM",
                            "risk_description": (
                                "Missing, ambiguous, or circular breadcrumbs "
                                "may prevent a clean-context worker from "
                                "reaching the required authority."
                            ),
                            "validation_description": (
                                "A clean-context worker can identify the "
                                "contract, schema, updater, command, template, "
                                "reference import, and required commands in "
                                "the correct order."
                            ),
                        },
                        {
                            "title": "Correct ambiguous breadcrumbs",
                            "description": (
                                "Replace vague guidance with definitive "
                                "repository-relative paths, filenames, "
                                "responsibilities, and next actions."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 60,
                            "estimate_confidence": "MEDIUM",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "No Hansel artifact relies on phrases such as "
                                "find the relevant file, use the appropriate "
                                "template, or inspect the subsystem without "
                                "naming the authoritative path."
                            ),
                        },
                        {
                            "title": "Verify minimal context loading",
                            "description": (
                                "Confirm that the worker can complete planning "
                                "without loading the entire planning subsystem, "
                                "full project history, or massive static "
                                "prompts."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 45,
                            "estimate_confidence": "MEDIUM",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The workflow requires only the handoff, "
                                "contract, template, and task-specific "
                                "executable authorities needed to resolve "
                                "uncertainty."
                            ),
                        },
                    ],
                },
                {
                    "title": "Complete Historical Documentation",
                    "description": (
                        "Preserve the Planning Knowledge Pipeline as the first "
                        "worked example of a Hansel-guided engineering process "
                        "that bootstrapped itself into the Decision Engine."
                    ),
                    "status": "PLANNED",
                    "steps": [
                        {
                            "title": "Record the final artifact chain",
                            "description": (
                                "Document the final repository paths and "
                                "responsibilities of the handoff, contract, "
                                "schema, updater, command, template, reference "
                                "import, and imported hierarchy."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 45,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "The complete artifact chain is recorded in "
                                "one discoverable location with no missing "
                                "links."
                            ),
                        },
                        {
                            "title": "Record deviations and lessons",
                            "description": (
                                "Document incorrect assumptions, schema "
                                "discoveries, naming decisions, contract "
                                "refinements, and workflow improvements found "
                                "while creating the reference implementation."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 60,
                            "estimate_confidence": "MEDIUM",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "A future worker can understand not only the "
                                "final workflow but also why its rules and "
                                "artifact boundaries were chosen."
                            ),
                        },
                        {
                            "title": "Define the reusable planning entry point",
                            "description": (
                                "Establish the definitive artifact future "
                                "architectural discussions should produce and "
                                "the exact contract that artifact must "
                                "reference."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 45,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "A future Initiative can begin by copying the "
                                "approved Planning Handoff pattern and "
                                "following the same Planning Update Contract."
                            ),
                        },
                        {
                            "title": "Validate the reference implementation",
                            "description": (
                                "Perform a final end-to-end validation from "
                                "Planning Handoff through imported Decision "
                                "Engine hierarchy and confirm the process is "
                                "repeatable."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 90,
                            "estimate_confidence": "MEDIUM",
                            "risk_level": "MEDIUM",
                            "risk_description": (
                                "The workflow defines how all future "
                                "Initiatives enter the Decision Engine, so "
                                "ambiguity would propagate into every later "
                                "planning effort."
                            ),
                            "validation_description": (
                                "The full workflow can be repeated without "
                                "tribal knowledge, conversational memory, or "
                                "unsupported assumptions, and every artifact "
                                "points deterministically to the next required "
                                "source."
                            ),
                        },
                    ],
                },
            ],
        },
    ],

