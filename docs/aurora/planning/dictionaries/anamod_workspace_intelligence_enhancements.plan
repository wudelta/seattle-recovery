{
    "schema_version": 1,

    "target": {
        "project_slug": "aurora",
    },

    "add_projects": [],

    "add_initiatives": [
        {
            "title": "Anamod Workspace Intelligence Enhancements",
            "description": (
                "Enhance Anamod's repository workspace with a supervised "
                "Load/Create file workflow, active-file Component Registry "
                "context, and reusable Component Registry maintenance and "
                "enrichment controls while preserving subsystem ownership "
                "boundaries and deterministic user feedback."
            ),
            "status": "ACTIVE",
            "phases": [
                {
                    "title": "Load/Create Workspace Flow",
                    "description": (
                        "Make repository-relative file loading explicit and "
                        "safe by distinguishing existing files from missing "
                        "files, supervising creation, and synchronizing the "
                        "Project Hierarchy with the active file."
                    ),
                    "status": "PLANNED",
                    "steps": [
                        {
                            "title": "Enforce bounded Anamod workspace paths",
                            "description": (
                                "Strengthen Anamod workspace path normalization "
                                "so repository-relative file operations cannot "
                                "escape the configured /app workspace while "
                                "preserving valid existing file operations."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 45,
                            "estimate_confidence": "HIGH",
                            "risk_level": "MEDIUM",
                            "risk_description": (
                                "Path-containment changes affect every Anamod "
                                "workspace mutation and must not reject valid "
                                "repository-relative paths."
                            ),
                            "validation_description": (
                                "Valid repository-relative paths continue to "
                                "read and create files, while traversal or "
                                "otherwise escaping paths are rejected before "
                                "filesystem access outside /app occurs."
                            ),
                            "document": {
                                "technical_design": (
                                    "Harden normalize_workspace_path() or its "
                                    "immediate workspace-service boundary so "
                                    "the resolved path is contained by "
                                    "WORKSPACE_ROOT before read, create, update, "
                                    "rename, or delete operations proceed."
                                ),
                                "dependencies": (
                                    "Anamod workspace_service.py and its "
                                    "WorkspaceOperationError HTTP adaptation."
                                ),
                                "assumptions": (
                                    "WORKSPACE_ROOT remains /app and valid "
                                    "Anamod paths are repository-relative."
                                ),
                                "implementation_notes": "",
                                "discussion": (
                                    "The requested Load/Create feature accepts "
                                    "typed paths. Existing source explicitly "
                                    "states that containment is not yet "
                                    "enforced, making this a safety prerequisite "
                                    "for supervised file creation."
                                ),
                            },
                            "validation": {
                                "description": (
                                    "Valid paths remain functional and paths "
                                    "resolving outside /app are deterministically "
                                    "rejected."
                                ),
                                "notes": "",
                            },
                            "planned_files": [
                                {
                                    "file_path": (
                                        "aurora/subsystems/anamod/services/"
                                        "workspace_service.py"
                                    ),
                                    "reason": (
                                        "Owns Anamod workspace path "
                                        "normalization and filesystem mutations."
                                    ),
                                },
                            ],
                            "actual_files": [],
                        },
                        {
                            "title": "Implement supervised Load/Create behavior",
                            "description": (
                                "Replace the Load File interaction with a "
                                "Load/Create workflow that loads existing files, "
                                "offers creation only for a true not-found "
                                "response, creates a blank file on approval, "
                                "and cancels without mutation."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 60,
                            "estimate_confidence": "HIGH",
                            "risk_level": "LOW",
                            "risk_description": "",
                            "validation_description": (
                                "An existing path loads normally; a missing path "
                                "produces an explicit Create/Cancel decision; "
                                "Create writes and loads a blank file; Cancel "
                                "creates nothing; and non-404 API failures remain "
                                "errors rather than creation prompts."
                            ),
                            "document": {
                                "technical_design": (
                                    "Reuse GET /aurora/api/files/op/ to detect "
                                    "existence and POST to the same authority "
                                    "with type=file and empty content for "
                                    "approved creation. Treat only HTTP 404 as "
                                    "the missing-file creation case."
                                ),
                                "dependencies": (
                                    "window.loadWorkspaceFile(), the Load File "
                                    "form in anamod_workspace.js, "
                                    "file_operation_api(), read_workspace_file(), "
                                    "and create_workspace_node()."
                                ),
                                "assumptions": (
                                    "The existing API preserves 404 for missing "
                                    "reads and 409 for create collisions."
                                ),
                                "implementation_notes": "",
                                "discussion": (
                                    "The current loader fails into the "
                                    "Operational Pipeline Log Feed. The desired "
                                    "workflow must explicitly supervise creation "
                                    "instead of silently treating every load "
                                    "failure the same."
                                ),
                            },
                            "validation": {
                                "description": (
                                    "Existing, missing-created, missing-cancelled, "
                                    "and non-404 failure cases each produce the "
                                    "specified observable behavior."
                                ),
                                "notes": "",
                            },
                            "planned_files": [
                                {
                                    "file_path": (
                                        "aurora/templates/aurora/anamod/"
                                        "anamod_console_panel.html"
                                    ),
                                    "reason": (
                                        "Owns the Load/Create control label and "
                                        "any confirmation UI surface."
                                    ),
                                },
                                {
                                    "file_path": (
                                        "aurora/static/aurora/js/anamod/"
                                        "anamod_workspace.js"
                                    ),
                                    "reason": (
                                        "Owns the repository-relative Load File "
                                        "form and tree workspace interaction."
                                    ),
                                },
                                {
                                    "file_path": (
                                        "aurora/static/aurora/js/anamod/"
                                        "anamod.js"
                                    ),
                                    "reason": (
                                        "Owns loading file contents into Monaco "
                                        "and active-file state."
                                    ),
                                },
                            ],
                            "actual_files": [],
                        },
                        {
                            "title": "Refresh and reveal the loaded or created file",
                            "description": (
                                "Generalize the existing Project Hierarchy "
                                "refresh/focus behavior so a typed file path can "
                                "be revealed after either loading an existing "
                                "file or creating a new blank file."
                            ),
                            "status": "PLANNED",
                            "estimated_minutes": 60,
                            "estimate_confidence": "MEDIUM",
                            "risk_level": "MEDIUM",
                            "risk_description": (
                                "The current focus helper depends on a known "
                                "parent jsTree node ID, which arbitrary typed "
                                "paths do not provide."
                            ),
                            "validation_description": (
                                "After Load/Create succeeds, Project Hierarchy "
                                "refreshes, the relevant parent path is expanded, "
                                "the target file is selected and visible in the "
                                "tree, and the same file is active in Monaco."
                            ),
                            "document": {
                                "technical_design": (
                                    "Reuse and generalize "
                                    "refreshAndFocusWorkspaceNode() so it can "
                                    "resolve the tree route from the target path "
                                    "rather than requiring only a previously "
                                    "selected parent node ID."
                                ),
                                "dependencies": (
                                    "jsTree data paths, refreshWorkspaceTree(), "
                                    "refreshAndFocusWorkspaceNode(), and "
                                    "window.loadWorkspaceFile()."
                                ),
                                "assumptions": (
                                    "Workspace tree nodes continue to expose "
                                    "their filesystem path through node.data.path."
                                ),
                                "implementation_notes": "",
                                "discussion": (
                                    "The context-menu create workflow already "
                                    "refreshes and focuses a new file. The typed "
                                    "Load/Create workflow should reuse that "
                                    "behavior rather than create a second tree "
                                    "synchronization mechanism."
                                ),
                            },
                            "validation": {
                                "description": (
                                    "Both existing-file load and approved "
                                    "missing-file creation leave Project "
                                    "Hierarchy expanded and focused on the same "
                                    "file shown in Monaco."
                                ),
                                "notes": "",
                            },
                            "planned_files": [
                                {
                                    "file_path": (
                                        "aurora/static/aurora/js/anamod/"
                                        "anamod_workspace.js"
                                    ),
                                    "reason": (
                                        "Owns Project Hierarchy refresh, "
                                        "selection, expansion, and Load/Create "
                                        "form behavior."
                                    ),
                                },
                            ],
                            "actual_files": [],
                        },
                    ],
