# ======================================================================
# FILE: .env (PATCH 1 OF 1)
# START: SYSTEM_ENVIRONMENT_CONFIG
# ======================================================================
# RELATIONAL DATABASE CONFIGURATION (POSTGRESQL TIER)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hopehub_production
DB_USER=delta_admin
DB_PASSWORD=local_secure_password
DB_HOST=postgres
DB_PORT=5432

# GRAPH NETWORK CONFIGURATION (NEO4J TIER)
# Uses the docker internal bridge service name inside the container network
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secure_graph_password_2026

# SECURITY & DJANGO SPECIFICS
DJANGO_SECRET_KEY=local_development_only_secret_key_change_in_prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
# ======================================================================
# END: SYSTEM_ENVIRONMENT_CONFIG (PATCH 1 OF 1)
# ======================================================================
